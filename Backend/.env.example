# --- Required ---
DATABASE_URL="postgresql://postgres:YOUR_ENCODED_PASSWORD@localhost:5432/rizqshare"
# A long random text. In production it must be at least 32 characters.
JWT_SECRET="change-me-to-a-long-random-text"
PORT=5000

# --- Website address(es) allowed to use the API, separated by commas ---
# Used for CORS and for the links inside emails. Change it when you deploy.
CLIENT_URL="http://localhost:5173"

# --- Password reset emails (optional) ---
# Without these, the reset link is printed in the backend terminal instead.
# Gmail: turn on 2-step verification, then create an "App password" for SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-letter-app-password"
MAIL_FROM="Rizq Share <your-address@gmail.com>"

# --- Food photos (optional) ---
# Free account at cloudinary.com. Without these, the photo field is hidden.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Only on the live server ---
# NODE_ENV=production
# TRUST_PROXY=1
